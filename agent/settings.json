{
  "lastChangelogVersion": "0.78.1",
  "defaultProvider": "opencode",
  "defaultModel": "minimax-m3-free",
  "terminal": {
    "showTerminalProgress": true
  },
  "compaction": {
    "enabled": true
  },
  "npmCommand": [
    "bun"
  ],
  "packages": [
    "npm:pi-web-access",
    "npm:pi-prompt-template-model",
    "npm:pi-lean-ctx",
    "npm:pi-provider-kiro",
    "npm:pi-codex-goal",
    "npm:pi-codex-account",
    "npm:pi-mcp-adapter",
    {
      "source": "git:github.com/fadilsflow/pi-co-authored-by@fix/current-pi-namespace",
      "extensions": [
        "+extensions/co-authored-by.ts"
      ]
    },
    "npm:@juicesharp/rpiv-ask-user-question"
  ],
  "quietStartup": true,
  "theme": "github-light-default",
  "treeFilterMode": "all",
  "defaultThinkingLevel": "high",
  "editorPaddingX": 2,
  "steeringMode": "one-at-a-time",
  "extensions": [
    "+extensions/9router-provider.ts"
  ],
  "skills": [
    "+skills/github-pr-summary/SKILL.md"
  ]
}