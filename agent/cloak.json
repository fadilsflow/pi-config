{
  "enabled": true,
  "cloakCharacter": "*",
  "cloakLength": null,
  "tryAllPatterns": true,
  "patterns": [
    {
      "filePattern": "**/*.env*",
      "cloakPattern": "(=).+",
      "replace": "$1"
    },
    {
      "filePattern": "**/*.vars*",
      "cloakPattern": "(=).+",
      "replace": "$1"
    },
    {
      "filePattern": ["**/*.json", "**/*.jsonc"],
      "cloakPattern": [
        {
          "pattern": "(\\\"(?:apiKey|api_key|token|access|refresh|secret|password|clientSecret|accessToken|refreshToken|idToken|sessionToken|authorization|FREEMODEL_API_KEY|BLUESMINDS_API_KEY|CONTEXT7_API_KEY)\\\"\\s*:\\s*\\\")[^\\\"]+",
          "replace": "$1"
        }
      ]
    },
    {
      "filePattern": ["~/.pi/agent/auth.json", "**/auth.json", "**/settings.json", "**/mcp.json"],
      "cloakPattern": [
        {
          "pattern": "(\\\"(?:apiKey|api_key|token|access|refresh|secret|password|clientSecret|accessToken|refreshToken|idToken|sessionToken|authorization|FREEMODEL_API_KEY|BLUESMINDS_API_KEY|CONTEXT7_API_KEY)\\\"\\s*:\\s*\\\")[^\\\"]+",
          "replace": "$1"
        }
      ]
    }
  ]
}
